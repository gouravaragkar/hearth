{
  "name": "Budget",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "Month in YYYY-MM format"
    },
    "amount": {
      "type": "number",
      "description": "Monthly budget amount"
    },
    "home_id": {
      "type": "string",
      "description": "Reference to the Home this budget belongs to"
    }
  },
  "required": [
    "month",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "service_role_bypass": true
  }
}