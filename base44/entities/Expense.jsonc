{
  "name": "Expense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the expense"
    },
    "amount": {
      "type": "number",
      "description": "Amount in the chosen currency"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code (e.g. AUD, INR, USD)",
      "default": "AUD"
    },
    "home_id": {
      "type": "string",
      "description": "Reference to the Home this expense belongs to"
    },
    "category": {
      "type": "string",
      "enum": [
        "Housing",
        "Utilities",
        "Insurance",
        "Subscriptions",
        "Groceries",
        "Transport",
        "Health",
        "Entertainment",
        "Education",
        "Other"
      ],
      "description": "Expense category"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of payment"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "name",
    "amount",
    "category",
    "date"
  ]
}