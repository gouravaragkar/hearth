{
  "name": "HomeActivity",
  "type": "object",
  "properties": {
    "home_id": {
      "type": "string",
      "description": "Reference to the Home"
    },
    "entity": {
      "type": "string",
      "description": "Entity type affected: Home, Expense, RecurringExpense, Budget"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete"
      ],
      "description": "CRUD action performed"
    },
    "actor_name": {
      "type": "string",
      "description": "Full name of the user who performed the action"
    },
    "actor_id": {
      "type": "string",
      "description": "User ID of the actor"
    },
    "record_name": {
      "type": "string",
      "description": "Human-readable name of the record affected (e.g. expense name)"
    },
    "details": {
      "type": "string",
      "description": "Optional extra details (e.g. amount, field changed)"
    }
  },
  "required": [
    "home_id",
    "entity",
    "action",
    "actor_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}